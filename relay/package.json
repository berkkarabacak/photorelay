{
  "name": "@photorelay/relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reference implementation of the RelaySync/1 fault-tolerant transfer protocol: Windows receiver, reference CLI sender, and golden test vectors.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "receiver": "tsx src/receiver/cli.ts",
    "sender": "tsx src/sender/cli.ts",
    "mklibrary": "tsx scripts/make-library.ts",
    "gen-vectors": "tsx scripts/gen-vectors.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cbor-x": "^1.6.0",
    "qrcode-terminal": "^0.12.0",
    "selfsigned": "^2.4.1",
    "xxhashjs": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
